{
  "api_id": "acme:bookshelf",
  "title": "Bookshelf API",
  "server_url": "https://api.bookshelf.example/v1",
  "base_path": "/v1",
  "security": {
    "type": "apiKey",
    "in": "header",
    "name": "X-API-Key"
  },
  "operations": [
    {
      "op_id": "list_books",
      "method": "GET",
      "path": "/books",
      "summary": "List books",
      "params": [
        {
          "name": "limit",
          "py_name": "limit",
          "in": "query",
          "required": false,
          "schema": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          }
        },
        {
          "name": "genre",
          "py_name": "genre",
          "in": "query",
          "required": false,
          "schema": {
            "type": "string",
            "enum": [
              "fiction",
              "history",
              "science"
            ]
          }
        },
        {
          "name": "tags",
          "py_name": "tags",
          "in": "query",
          "required": false,
          "schema": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      ],
      "body": null,
      "response": {
        "status": 200,
        "schema": {
          "type": "object",
          "required": [
            "items",
            "total"
          ],
          "properties": {
            "items": {
              "type": "array",
              "items": {
                "allOf": [
                  {
                    "type": "object",
                    "required": [
                      "title"
                    ],
                    "properties": {
                      "title": {
                        "type": "string",
                        "minLength": 3,
                        "maxLength": 30
                      },
                      "published": {
                        "type": "string",
                        "format": "date"
                      },
                      "pages": {
                        "type": "integer",
                        "minimum": 10,
                        "maximum": 900
                      }
                    }
                  },
                  {
                    "type": "object",
                    "required": [
                      "id",
                      "created_at",
                      "author_email"
                    ],
                    "properties": {
                      "id": {
                        "type": "string",
                        "format": "uuid"
                      },
                      "created_at": {
                        "type": "string",
                        "format": "date-time"
                      },
                      "author_email": {
                        "type": "string",
                        "format": "email"
                      },
                      "cover": {
                        "type": "string",
                        "format": "uri",
                        "nullable": true
                      },
                      "status": {
                        "type": "string",
                        "enum": [
                          "available",
                          "lent"
                        ]
                      },
                      "rating": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 5
                      }
                    }
                  }
                ]
              }
            },
            "total": {
              "type": "integer",
              "minimum": 0,
              "maximum": 500
            }
          }
        }
      },
      "auth_required": true
    },
    {
      "op_id": "create_book",
      "method": "POST",
      "path": "/books",
      "summary": "Create a book",
      "params": [],
      "body": {
        "required": true,
        "schema": {
          "allOf": [
            {
              "type": "object",
