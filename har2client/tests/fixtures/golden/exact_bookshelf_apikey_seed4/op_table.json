                  "maxLength": 30
                },
                "published": {
                  "type": "string",
                  "format": "date"
                },
                "pages": {
                  "type": "integer",
                  "minimum": 10,
                  "maximum": 900
                }
              }
            },
            {
              "type": "object",
              "required": [
                "isbn"
              ],
              "properties": {
                "isbn": {
                  "type": "string",
                  "minLength": 10,
                  "maxLength": 13
                }
              }
            }
          ]
        }
      },
      "response": {
        "status": 201,
        "schema": {
          "allOf": [
            {
              "type": "object",
              "required": [
                "title"
              ],
              "properties": {
                "title": {
                  "type": "string",
                  "minLength": 3,
                  "maxLength": 30
                },
                "published": {
                  "type": "string",
                  "format": "date"
                },
                "pages": {
                  "type": "integer",
                  "minimum": 10,
                  "maximum": 900
                }
              }
            },
            {
              "type": "object",
              "required": [
                "id",
                "created_at",
                "author_email"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "format": "uuid"
                },
                "created_at": {
                  "type": "string",
                  "format": "date-time"
                },
                "author_email": {
                  "type": "string",
                  "format": "email"
                },
                "cover": {
                  "type": "string",
                  "format": "uri",
                  "nullable": true
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "available",
                    "lent"
                  ]
                },
                "rating": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 5
                }
              }
            }
          ]
        }
      },
      "auth_required": true
    },
